# Copie este arquivo para .env e ajuste o que precisar:
#
#   cp .env.example .env
#
# O .env NUNCA vai para o Git. Ele esta no .gitignore, e deve continuar la.
# Os valores abaixo funcionam como estao para desenvolvimento local.

# ---------------------------------------------------------------------------
# Portas expostas na sua maquina
# ---------------------------------------------------------------------------
# Se alguma delas ja estiver ocupada por outro programa, mude aqui.
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# O mesmo Postgres guarda os dados relacionais e, com a extensao pgvector,
# os vetores usados na busca por similaridade.
POSTGRES_USER=yourjourney
POSTGRES_PASSWORD=yourjourney_local
POSTGRES_DB=yourjourney

# ---------------------------------------------------------------------------
# Ainda nao usados: entram junto com as proximas fatias do projeto
# ---------------------------------------------------------------------------
